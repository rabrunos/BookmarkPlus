{
  "manifest_version": 3,
  "name": "Bookmark+",
  "version": "0.4.1",
  "description": "Bookmark manager for Edge with separated roots, collapsible folders, drag-and-drop, HTML import and backups.",
  "permissions": [
    "bookmarks",
    "storage",
    "clipboardRead",
    "clipboardWrite",
    "favicon"
  ],
  "action": {
    "default_title": "Favoritos+",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/star16.png",
      "32": "icons/star32.png"
    }
  },
  "chrome_url_overrides": {
    "bookmarks": "bookmarks.html"
  },
  "icons": {
    "16": "icons/star16.png",
    "32": "icons/star32.png",
    "48": "icons/star48.png",
    "128": "icons/star128.png"
  },
  "key": "",
  "background": {
    "service_worker": "service-worker.js"
  },
  "externally_connectable": {
    "ids": [
      "econfanmnmmcggpgdflcipmdlmkcbiag"
    ]
  }
}
